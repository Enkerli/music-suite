{
  "name": "music-suite",
  "private": true,
  "description": "Monorepo for the Enkerli music suite: shared theory core, design tokens, codegen, and webapps",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/theory packages/codegen packages/corpus-tools packages/midi",
    "sync-apps": "node scripts/sync-apps.mjs",
    "build-site": "node docs/build-site.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.10.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
