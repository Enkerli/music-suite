{
  "name": "@enkerli/ui",
  "version": "0.2.0",
  "description": "Design tokens and shared web components for the Enkerli music suite (browsers and JUCE WebViews)",
  "license": "CC0-1.0",
  "exports": {
    "./components.css": "./tokens/components.css",
    "./confirm": {
      "types": "./confirm.d.ts",
      "default": "./confirm.js"
    },
    "./fonts.css": "./fonts.css",
    "./global-cluster": "./components/global-cluster.js",
    "./icons/*": "./icons/*",
    "./knob": "./components/knob.js",
    "./leadsheet-editor": "./components/leadsheet-editor.js",
    "./library-browser": {
      "types": "./components/library-browser.d.ts",
      "default": "./components/library-browser.js"
    },
    "./naming": {
      "types": "./naming.d.ts",
      "default": "./naming.js"
    },
    "./pcs-ring": "./components/pcs-ring.js",
    "./piano-roll": "./components/piano-roll.js",
    "./pitch-class-colors": "./components/pitch-class-colors.js",
    "./pitch-grid": "./components/pitch-grid.js",
    "./range-slider": "./components/range-slider.js",
    "./rhythm-views": "./components/rhythm-views.js",
    "./section": "./components/section.js",
    "./theme": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    },
    "./toast": {
      "types": "./components/toast.d.ts",
      "default": "./components/toast.js"
    },
    "./tokens.css": "./tokens/tokens.css"
  },
  "files": [
    "tokens",
    "icons",
    "theme.js",
    "theme.d.ts",
    "components",
    "naming.js",
    "naming.d.ts",
    "confirm.js",
    "confirm.d.ts",
    "fonts.css",
    "fonts"
  ],
  "dependencies": {
    "@enkerli/theory": "*",
    "@enkerli/upi": "*"
  }
}
