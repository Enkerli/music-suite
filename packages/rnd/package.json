{
  "name": "@enkerli/rnd",
  "version": "0.1.0",
  "description": "Wire codec for the Cymaforma RND Synth: 32-bit seeds, SysEx status frames, and the CC/note control map",
  "type": "module",
  "license": "Unlicense",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/*": "./vectors/*",
    "./library": {
      "source": "./src/library.ts",
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    }
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@enkerli/library": "*"
  }
}
