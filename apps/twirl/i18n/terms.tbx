            <term>beat</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>temps</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
          <tig>
            <term>pulsation</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>battement</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="bar">
        <descrip type="subjectField">Twirl · music</descrip>
        <note>match:en:bars?</note>
