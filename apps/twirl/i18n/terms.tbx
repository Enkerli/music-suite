        <note>match:fr:effac\w*|vid\w*</note>
        <langSet xml:lang="en">
          <descrip type="definition">remove loops</descrip>
          <tig>
            <term>clear</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>effacer</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
