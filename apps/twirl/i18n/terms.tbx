            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="tempo">
        <descrip type="subjectField">Twirl · music</descrip>
        <note>match:en:tempo</note>
        <note>match:fr:tempo</note>
        <langSet xml:lang="en">
          <descrip type="definition">beats per minute</descrip>
