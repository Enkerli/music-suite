          <tig>
            <term>Malle à jouets</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="mytoys">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:my toys</note>
        <note>match:fr:mes jouets</note>
        <langSet xml:lang="en">
          <descrip type="definition">the toys you kept</descrip>
          <tig>
            <term>My toys</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Mes jouets</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="take">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>verb 'take' also appears: only the noun is this term</note>
        <note>match:en:takes?</note>
        <note>match:fr:prises?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a recording of what you did on the sheet, to replay</descrip>
