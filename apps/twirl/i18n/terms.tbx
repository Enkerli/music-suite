      <termEntry id="beat">
        <descrip type="subjectField">Twirl · music</descrip>
        <note>Beats (the view) is Pulsations: Temps is the Time section</note>
        <note>match:en:beats?</note>
        <note>match:fr:temps|pulsations?</note>
        <langSet xml:lang="en">
          <descrip type="definition">the pulse; a loop's length counts in beats</descrip>
