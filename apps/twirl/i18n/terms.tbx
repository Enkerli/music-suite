<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif SYSTEM "TBXBasiccoreStructV02.dtd">
<martif type="TBX-Basic" xml:lang="en">
  <martifHeader>
    <fileDesc><sourceDesc><p>Twirl's terms, English and French (normative Québec French). Draft for review, 2026-10-27.</p></sourceDesc></fileDesc>
    <encodingDesc><p type="XCSURI">TBXBasicXCSV02.xcs</p></encodingDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="sheet">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:sheets?</note>
        <note>match:fr:feuilles?</note>
        <langSet xml:lang="en">
          <descrip type="definition">the surface you draw on (the whole canvas)</descrip>
          <tig>
            <term>sheet</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>feuille</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
          <tig>
            <term>toile</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>page</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="stroke">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>tracé is used for a loop's path</note>
        <note>match:en:strokes?</note>
        <note>match:fr:traits?|tracés?</note>
        <langSet xml:lang="en">
          <descrip type="definition">one gesture as drawn, before or as it becomes a loop</descrip>
          <tig>
            <term>stroke</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>trait</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
          <tig>
            <term>tracé</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>geste</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="path">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:paths?</note>
        <note>match:fr:tracés?|chemins?</note>
        <langSet xml:lang="en">
          <descrip type="definition">the shape a loop follows on the sheet</descrip>
          <tig>
            <term>path</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>tracé</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
          <tig>
            <term>chemin</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>parcours</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="loop">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:loops?</note>
        <note>match:fr:boucles?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a stroke that keeps replaying</descrip>
          <tig>
            <term>loop</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>boucle</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="pass">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:pass(es)?</note>
        <note>match:fr:tours?|passages?</note>
        <langSet xml:lang="en">
          <descrip type="definition">one time round a loop (Life and Meets count in passes)</descrip>
          <tig>
            <term>pass</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>tour</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · coined</note>
          </tig>
          <tig>
            <term>passage</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>cycle</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>révolution</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="playhead">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:playheads?</note>
        <note>match:fr:têtes? de lecture</note>
        <langSet xml:lang="en">
          <descrip type="definition">the dot that travels a loop, playing its notes</descrip>
          <tig>
            <term>playhead</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>tête de lecture</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
          <tig>
            <term>curseur de lecture</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>point de lecture</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="note">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:notes?</note>
        <note>match:fr:notes?</note>
        <langSet xml:lang="en">
          <descrip type="definition">one sound a loop plays where its path crosses a line</descrip>
          <tig>
            <term>note</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>note</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="line">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:lines?</note>
        <note>match:fr:lignes?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a horizontal line of the grid: one pitch</descrip>
          <tig>
            <term>line</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>ligne</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
          <tig>
            <term>portée (no)</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>corde</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="pen">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:pens?</note>
        <note>match:fr:crayons?|stylos?</note>
        <langSet xml:lang="en">
          <descrip type="definition">what a new stroke plays: its voice and options</descrip>
          <tig>
            <term>pen</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>crayon</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · coined</note>
          </tig>
          <tig>
            <term>stylo</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>plume</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>pinceau</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="palette">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:palettes?</note>
        <note>match:fr:palettes?</note>
        <langSet xml:lang="en">
          <descrip type="definition">the row of pens to pick from</descrip>
          <tig>
            <term>palette</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>palette</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="chip">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>puce is also the Chip pack: a clash</note>
        <note>match:en:chips?</note>
        <note>match:fr:puces?|pastilles?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a loop's small button in the list of loops (opens its settings)</descrip>
          <tig>
            <term>chip</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>puce</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · coined</note>
          </tig>
          <tig>
            <term>pastille</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>étiquette</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="child">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:child(ren)?</note>
        <note>match:fr:enfants?|rejetons?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a loop born when two loops meet (Breed)</descrip>
          <tig>
            <term>child</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>enfant</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · coined</note>
          </tig>
          <tig>
            <term>rejeton</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
          <tig>
            <term>descendant</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="group">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:groups?</note>
        <note>match:fr:groupes?</note>
        <langSet xml:lang="en">
          <descrip type="definition">group A–D: one level and mute for several loops</descrip>
          <tig>
            <term>group</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>groupe</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="generation">
        <descrip type="subjectField">Twirl · on the sheet</descrip>
        <note>match:en:generations?</note>
        <note>match:fr:générations?</note>
        <langSet xml:lang="en">
          <descrip type="definition">how many Breeds back a loop goes</descrip>
          <tig>
            <term>generation</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>génération</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="scene">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:scenes?</note>
        <note>match:fr:scènes?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a saved sheet (six slots, and files in the plugin)</descrip>
          <tig>
            <term>scene</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>scène</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="toy">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:toys?</note>
