          <tig>
            <term>gabarit</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="code">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:codes?</note>
        <note>match:fr:codes?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a short text that carries a whole sheet (to share)</descrip>
          <tig>
            <term>code</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>code</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="link">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:links?</note>
        <note>match:fr:liens?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a web address carrying a sheet</descrip>
          <tig>
            <term>link</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>lien</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="share">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:share[ds]?|sharing</note>
        <note>match:fr:partag\w*</note>
        <langSet xml:lang="en">
          <descrip type="definition">to give a sheet to someone (link or code)</descrip>
          <tig>
            <term>share</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>partager</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="settings">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>paramètre is also the host's 'parameter'</note>
        <note>match:en:settings?</note>
        <note>match:fr:réglages?|paramètres?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a loop's settings panel; Twirl's settings</descrip>
          <tig>
            <term>settings</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
