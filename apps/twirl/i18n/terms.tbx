            <term>take</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>prise</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <note>draft · usual</note>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="template">
        <descrip type="subjectField">Twirl · kept and shared</descrip>
        <note>match:en:templates?</note>
        <note>match:fr:modèles?|gabarits?</note>
        <langSet xml:lang="en">
          <descrip type="definition">a starting sheet carried in a link</descrip>
          <tig>
            <term>template</term>
